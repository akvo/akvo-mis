# Direct dependencies. `requirements.txt` is generated from this file
# and pins every transitive package too, so the images install exactly
# what was tested. After editing this file, re-lock with:
#
#   ./dc.sh exec backend sh -c "pip -q install uv && uv pip compile \
#     --python-version 3.8 requirements.in -o requirements.txt"
#
# Without `--upgrade` uv keeps the existing pins and only resolves what
# changed; `--upgrade-package <name>` moves one package on purpose.

