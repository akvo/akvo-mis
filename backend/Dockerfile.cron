FROM python:3.12.15-slim-bookworm

ENV PYTHONUNBUFFERED=1

WORKDIR /app

#Install Cron
RUN apt-get update
RUN apt-get -y install cron

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
# Install into the image's Python, not a .venv. --inexact keeps pip
# and anything else uv did not install; --no-dev keeps test and debug
# tools out of production.
ENV UV_PROJECT_ENVIRONMENT=/usr/local UV_LINK_MODE=copy
COPY pyproject.toml uv.lock /app/
RUN uv sync --locked --no-dev --inexact --no-cache && pip check

copy . /app/

# Add the cron job
RUN crontab /app/mis-cron

# Create the log file to be able to run tail
RUN touch /app/cron.log

CMD cron && tail -f /app/cron.log