FROM python:3.12.15-slim-bookworm

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt /app/

# cron runs job.sh; curl is how job.sh tells the SQL proxy sidecar to
# exit, without which the CronJob pod never completes. The slim base
# image ships neither.
RUN apt-get update \
    && apt-get -y install --no-install-recommends cron curl \
    && rm -rf /var/lib/apt/lists/*

RUN set -e; \
    pip -q install --upgrade pip && \
    pip -q install --no-cache-dir -r requirements.txt && \
    pip check

copy . /app/

# Add the cron job
RUN crontab /app/mis-cron

# Create the log file to be able to run tail
RUN touch /app/cron.log

CMD cron && tail -f /app/cron.log