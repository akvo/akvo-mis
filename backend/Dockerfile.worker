FROM python:3.12.15-slim-bookworm

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
# Install into the image's Python, not a .venv. --inexact keeps pip
# and anything else uv did not install; --no-dev keeps test and debug
# tools out of production.
ENV UV_PROJECT_ENVIRONMENT=/usr/local UV_LINK_MODE=copy
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-dev --inexact --no-cache && pip check

copy . /app/


CMD ["python","manage.py","qcluster"]
