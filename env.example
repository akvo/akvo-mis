APP_NAME="Akvo MIS"
APP_SHORT_NAME=akvo-mis
APK_NAME="Akvo MIS"
APK_SHORT_NAME="akvo-mis"
SHOW_LANDING_PAGE=false
DB_HOST=db
DB_PASSWORD=password
DB_SCHEMA=mis
DB_USER=akvo
DEBUG="True"
DJANGO_SECRET=local-secret
# Mail. Local development needs none of these: docker-compose.override.yml
# pins the backend and worker at the Mailpit container, which accepts
# anything without authenticating and shows it at http://localhost:8025.
# Set them only for a deployment that sends real mail.
# EMAIL_HOST=mail.example.org
# EMAIL_PORT=465
# EMAIL_HOST_USER=noreply@example.org
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_SSL=true    # port 465. Use EMAIL_USE_TLS instead for 587.
# EMAIL_FROM=noreply@example.org
WEBDOMAIN="http://example.com"
# Subdomain routing. Empty (the default) means one host serves everything
# and host-based tenant resolution is inert — set it and each workspace
# lives at <subdomain>.<BASE_DOMAIN>. Locally this needs an /etc/hosts
# line per workspace; see docs/subdomain-local-dev.md.
BASE_DOMAIN=
# Origin serving embedded dashboards' external content, e.g.
# https://embed.example.com. Empty (the default) turns embedding off:
# those dashboards say so instead of rendering. It must never be this
# app's own origin — see "Embedded dashboards" in the README.
EMBED_HOST=
# Comma-separated subdomains of the workspaces entitled to embedding,
# e.g. "acme,globex". Embedding is a paid tier, so EMBED_HOST alone
# renders nothing: both are required. Empty (the default) entitles
# nobody. Single-host deployments name their one workspace, "default".
EMBED_TENANTS=
IP_ADDRESS="http://example.com/api/v1/device"
APK_UPLOAD_SECRET="secret-apk-upload"
STORAGE_PATH=
EXPO_TOKEN=
SENTRY_DSN=
SENTRY_MOBILE_ENV=
SENTRY_MOBILE_DSN=
SENTRY_MOBILE_AUTH_TOKEN=
# CartoDB tile API key for map rendering (frontend, build-time)
REACT_APP_CARTO_API_KEY=
# AI Chatbot (OpenAI Assistants API + Vector Store)
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
OPENAI_VECTOR_STORE_ID=