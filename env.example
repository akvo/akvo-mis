APP_NAME="Akvo MIS"
APP_SHORT_NAME=akvo-mis
APK_NAME="Akvo MIS"
APK_SHORT_NAME="akvo-mis"
SHOW_LANDING_PAGE=false
DB_HOST=db
DB_PASSWORD=password
DB_SCHEMA=mis
DB_USER=akvo
DEBUG="True"
DJANGO_SECRET=local-secret
# Mail. Local development needs none of these: docker-compose.override.yml
# pins the backend and worker at the Mailpit container, which accepts
# anything without authenticating and shows it at http://localhost:8025.
# Set them only for a deployment that sends real mail.
# EMAIL_HOST=mail.example.org
# EMAIL_PORT=465
# EMAIL_HOST_USER=noreply@example.org
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_SSL=true    # port 465. Use EMAIL_USE_TLS instead for 587.
# EMAIL_FROM=noreply@example.org
# The address the browser actually uses. Every emailed link is built
# from this -- scheme and port from here, host from BASE_DOMAIN below --
# so leaving the placeholder in place locally mails links without the
# :3000 and they open nothing.
WEBDOMAIN="http://example.com"
# Subdomain routing. Empty (the default) means one host serves everything
# and host-based tenant resolution is inert — set it and each workspace
# lives at <subdomain>.<BASE_DOMAIN>. Locally this needs an /etc/hosts
# line per workspace; see docs/subdomain-local-dev.md.
BASE_DOMAIN=
# The label the platform console answers on, under BASE_DOMAIN: with
# the default, the console is at admin.<BASE_DOMAIN>. Change it only if
# that address is already taken — by another service, or by a workspace
# registered before the name was reserved. Registration and rename both
# refuse whatever this is set to, and changing it on a running
# deployment needs `manage.py generate_config` so the frontend learns
# the new label too.
ADMIN_SUBDOMAIN=admin
# Origin serving embedded dashboards' external content, e.g.
# https://embed.example.com. Empty (the default) turns embedding off:
# those dashboards say so instead of rendering. It must never be this
# app's own origin — see "Embedded dashboards" in the README.
EMBED_HOST=
IP_ADDRESS="http://example.com/api/v1/device"
APK_UPLOAD_SECRET="secret-apk-upload"
STORAGE_PATH=
EXPO_TOKEN=
SENTRY_DSN=
SENTRY_MOBILE_ENV=
SENTRY_MOBILE_DSN=
SENTRY_MOBILE_AUTH_TOKEN=
# CartoDB tile API key for map rendering (frontend, build-time)
REACT_APP_CARTO_API_KEY=
# AI Chatbot (OpenAI Assistants API + Vector Store)
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
OPENAI_VECTOR_STORE_ID=
# Hours a workspace has to finish signing up (naming its top level and
# root unit) before it is purged and its subdomain freed. Must be at
# least 1; the process refuses to boot otherwise. This is also how long
# an activation link stays valid — the link must not outlive the
# workspace it activates.
TENANT_PURGE_AFTER_HOURS=48# Proxies between a client and the backend, used to find the client
# address in X-Forwarded-For. 0 (the default) means "use REMOTE_ADDR"
# and is right for local development and for any single-host
# deployment. The GKE deployments set 2: the GCLB appends both the
# client address and its own, and nginx passes the header through. Get
# this wrong and either every caller shares one rate-limit bucket, or
# each one gets a fresh bucket per request.
NUM_PROXIES=0
# Self-service sign-up. Unset, it follows BASE_DOMAIN: on by default
# for a multi-tenant deployment, off for a dedicated single-customer
# one. Local development runs with BASE_DOMAIN empty, so set this to
# true to work on the sign-up form -- otherwise the form renders and
# POST /api/v1/register answers 403.
# SIGNUP_ENABLED=true
# Cloudflare Turnstile on the sign-up form. Both empty (the default)
# means no captcha. Enable in two steps, in this order: set the site
# key, wait for nginx's day-long cache of /config.js to turn over so
# clients are sending tokens, then set the secret so the backend starts
# requiring them. Both at once refuses every registrant whose cached
# config.js predates the site key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# To exercise the captcha locally, Cloudflare publishes dummy keys that
# work on any hostname and need no account. Always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Always block, for the refusal path:
#   TURNSTILE_SITE_KEY=2x00000000000000000000AB
#   TURNSTILE_SECRET=2x0000000000000000000000000000000AA
